@model SuperMarketMangementSystem.Models.Entities.Category

@{
    ViewData["Title"] = "NewCategory";
    Layout = "~/Views/Shared/_CategoryLayout.cshtml";
}

<h1>Add New Category</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="SaveNewCategory" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-outline mt-2" >
                <input type="submit" value="Add" class="btn btn-primary" />
                <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("AllCategory", "Category")'">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

