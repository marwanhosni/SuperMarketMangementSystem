@model List<Category>
@{
    ViewData["Title"] = "AllCategory";
    Layout = "~/Views/Shared/_CategoryLayout.cshtml";
}


<h1>Mange Category</h1>
<table class="table table-striped w-100">
    <!-- إضافة w-100 لجعل الجدول بعرض الشاشة بالكامل -->

    <thead>
       
        <tr>
            <th scope="col" >Name</th>
            <th scope="col" >Description</th>
            @if (User.IsInRole("admin"))
            {
                <th scope="col">Edit</th>
                <th scope="col">Delete</th>
            }
    </tr>
    </thead>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#products-@item.Id" aria-expanded="false" aria-controls="products-@item.Id">
                    <i class="bi bi-chevron-down"></i> @item.Name
                </button>
            </td>
            <td>@item.Description</td>
            @if (User.IsInRole("admin"))
            {
                <td>
                    <a asp-action="EditCategory" asp-controller="Category" asp-route-id="@item.Id" style="text-decoration: none;">Edit</a>
                </td>
                <td>
                    <a href="javascript:void(0);" onclick="confirmDelete('@Url.Action("ConfirmDelete", "Category", new { id = item.Id })')" style="text-decoration: none;">Delete</a>

                </td>
            }
            <tr>
                <td colspan="@(User.IsInRole("admin") ? 4 : 2)">
                    <div class="collapse" id="products-@item.Id">
                        <div class="card card-body">
                            @if (item.Products != null && item.Products.Any())
                            {
                                <ul>
                                    @foreach (var product in item.Products)
                                    {
                                        <li>@product.Name</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>No products available in this category.</p>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        </tr>
    }
</table>
@if (User.IsInRole("admin")){
<button type="button" class="btn btn-primary" onclick="window.location.href='@Url.Action("NewCategory", "Category")'">
    Add New Category
</button>
}


<style>
    .bi-chevron-down::before {
        transition: transform 0.3s ease;
    }

    .btn-link[aria-expanded="true"] .bi-chevron-down::before {
        transform: rotate(180deg);
    }
</style>
@* دا الاكشن الي بيخلي لما اعمل حذف ينزل بانر من فوق ياكد الحذف *@
<script>
    function confirmDelete(url) {
        if (confirm("Are you sure you want to delete this category?")) {
            window.location.href = url;
        }
    }
</script>
