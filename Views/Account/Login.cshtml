@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div style="text-align: center ;">
    <h1>Login</h1>
</div>

<hr />

<div class="row">
    <div class="row-cols-md-1" >
        <form asp-action="SaveLogin"  >
            <div asp-validation-summary="All" class="text-danger"></div>

            <div data-mdb-input-init class="form-outline mb-2">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div data-mdb-input-init class="form-outline mb-2">
                <label asp-for="password" class="control-label"></label>
                <input asp-for="password" class="form-control" />
                <span asp-validation-for="password" class="text-danger"></span>
            </div>

            <div data-mdb-input-init class="form-outline mb-2">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="RemeberMe" /> @Html.DisplayNameFor(model => model.RemeberMe)
                </label>
            </div>

            <div class="float-end">
                <a asp-controller="Account" asp-action="VerifyEmail" class="text-decoration-none">
                    Forgot password?
                </a>
            </div>
           
            <div data-mdb-input-init class="form-outline mb-2">
                <input type="submit" value="Login" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>





