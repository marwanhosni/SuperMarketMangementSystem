@model List<CartItem>

@{
    ViewData["Title"] = "Purchase Confirmation";
    Layout = "~/Views/Shared/_CategoryLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Purchase Confirmation</title>
    <style>
        @@media print {
            .btn, .mt-3 {
                display: none; /* Hide Buttons While Printing */
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid #ddd;
                padding: 8px;
                text-align: left;
            }

            h3 {
                text-align: center;
            }

            .receipt-header {
                text-align: center;
                margin-bottom: 20px;
            }

            .receipt-footer {
                text-align: right;
                margin-top: 20px;
            }
        }

        .table th, .table td {
            padding: 10px;
            text-align: left;
        }

        .total-price {
            font-size: 1.2em;
            font-weight: bold;
            text-align: right;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <h1>Purchase Confirmation</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <p>No items to display.</p>
    }
    else
    {
        <div class="receipt-header">
            <h3>Thank you for your purchase!</h3>
            <p>Date: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price.ToString("F2") EGP</td>
                        <td>@((item.Quantity * item.Price).ToString("F2")) EGP</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="total-price receipt-footer">
            Total: @Model.Sum(item => item.Price * item.Quantity).ToString("F2") EGP
        </div>

        <button onclick="window.print()" class="btn btn-secondary btn-lg mt-3">Print Receipt</button>

        <div class="mt-3">
            <a asp-controller="Product" asp-action="GetAllProduct" class="btn btn-primary">Back To All Products</a>
            <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-info">Go to My Orders</a>
        </div>
    }
</body>
</html>