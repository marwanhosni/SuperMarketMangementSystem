@model List<SuperMarketMangementSystem.Models.Entities.Order>

@{
    ViewData["Title"] = "All Orders";
    Layout = "~/Views/Shared/_CategoryLayout.cshtml";
}

<h1>All Orders</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model == null || !Model.Any())
{
    <p>No orders available.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Order #</th>
                <th>User</th>
                <th>Order Date</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Items</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.User.UserName</td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@order.TotalPrice EGP</td>
                    <td>@order.Status</td>
                    <td>
                        <ul>
                            @foreach (var item in order.OrderItems)
                            {
                                <li>@item.Product.Name (Qty: @item.Quantity, Price: @item.UnitPrice EGP)</li>
                            }
                        </ul>
                    </td>
                    <td>
                        <form asp-action="UpdateOrderStatus" method="post" style="display:inline;">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <select name="status" onchange="this.form.submit()">
                                <option value="Pending" selected="@(order.Status == "Pending" ? "selected" : null)">Pending</option>
                                <option value="Delivered" selected="@(order.Status == "Delivered" ? "selected" : null)">Delivered</option>
                                <option value="Cancelled" selected="@(order.Status == "Cancelled" ? "selected" : null)">Cancelled</option>
                            </select>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}