@model Products
@{
    ViewData["Title"] = "Confirm Delete Product";
    Layout = "~/Views/Shared/_CategoryLayout.cshtml";
}
<h2>Confirm Delete Product </h2>
<hr />

<p>Are you sure you want to delete this category?</p>
<div>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Price:</strong> @Model.Price</p>
    <p><strong>Quantity:</strong> @Model.Quantity</p>
    <p><strong>CategoryId:</strong> @Model.CategoryId</p>
</div>

<form asp-action="DeleteProduct" asp-controller="Product" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="GetAllProduct" class="btn btn-secondary">Cancel</a>
</form>










