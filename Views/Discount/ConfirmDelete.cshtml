@model SuperMarketMangementSystem.Models.Entities.Discount
@{
    ViewData["Title"] = "Confirm Delete";
    Layout = "~/Views/Shared/_CategoryLayout.cshtml";
}

<h2>Confirm Delete</h2>
<hr />
<p>Are you sure you want to delete this discount?</p>
<div>
    <p><strong>Name:</strong> @(string.IsNullOrWhiteSpace(Model.Name) ? "Not specified" : Model.Name)</p>
    <p><strong>Discount Percentage:</strong> @Model.DiscountPercentage%</p>
    <p><strong>Start Date:</strong> @(Model.StartDate != default(DateTime) ? Model.StartDate.ToString("dd/MM/yyyy") : "Not specified")</p>
    <p><strong>End Date:</strong> @(Model.EndDate != default(DateTime) ? Model.EndDate.ToString("dd/MM/yyyy") : "Not specified")</p>
    <p><strong>Product:</strong> @(Model.Product?.Name ?? "Not specified")</p>
    <p><strong>Category:</strong> @(Model.Category?.Name ?? "Not specified")</p>
</div>
<form asp-action="DeleteDiscount" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="AllDiscounts" class="btn btn-secondary">Cancel</a>
</form>
