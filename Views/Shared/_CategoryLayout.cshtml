
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SuperMarketMangementSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuperMarketMangementSystem.styles.css" asp-append-version="true" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Bootstrap JavaScript (في نهاية الـ body) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

    <nav class="site-header sticky-top py-1">
        <div class="container d-flex flex-column flex-md-row justify-content-between">
            @if (User.IsInRole("MangmentOfOrders"))
            {
                <a class="py-2" asp-action="UserProfile" asp-controller="Home">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="d-block mx-auto"><circle cx="12" cy="12" r="10"></circle><line x1="14.31" y1="8" x2="20.05" y2="17.94"></line><line x1="9.69" y1="8" x2="21.17" y2="8"></line><line x1="7.38" y1="12" x2="13.12" y2="2.06"></line><line x1="9.69" y1="16" x2="3.95" y2="6.06"></line><line x1="14.31" y1="16" x2="2.83" y2="16"></line><line x1="16.62" y1="12" x2="10.88" y2="21.94"></line></svg>
                </a>
                <a class="py-2 d-none d-md-inline-block" asp-action="Index" asp-controller="Home">Home</a>
                <a class="py-2 d-none d-md-inline-block" asp-action="AllOrders" asp-controller="Orders">Mange Orders</a>

                <a class="py-2 d-none d-md-inline-block" href="#">Hello, @Context.User.Identity.Name!</a>
                <a class="py-2 d-none d-md-inline-block" asp-action="Signout" asp-controller="Account">SignOut</a>
            }
            else
            {
                @if (User.IsInRole("admin") || User.IsInRole("User"))
                {
                    <a class="py-2" asp-action="UserProfile" asp-controller="Home">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="d-block mx-auto"><circle cx="12" cy="12" r="10"></circle><line x1="14.31" y1="8" x2="20.05" y2="17.94"></line><line x1="9.69" y1="8" x2="21.17" y2="8"></line><line x1="7.38" y1="12" x2="13.12" y2="2.06"></line><line x1="9.69" y1="16" x2="3.95" y2="6.06"></line><line x1="14.31" y1="16" x2="2.83" y2="16"></line><line x1="16.62" y1="12" x2="10.88" y2="21.94"></line></svg>
                    </a>
                }
                <a class="py-2 d-none d-md-inline-block" asp-action="Index" asp-controller="Home">Home</a>
                <a class="py-2 d-none d-md-inline-block" asp-action="GetAllProduct" asp-controller="Product">Product</a>
                <a class="py-2 d-none d-md-inline-block" asp-action="Allcategory" asp-controller="Category">Categories</a>

                @if (User.IsInRole("admin"))
                {
                    <a class="py-2 d-none d-md-inline-block btn btn-outline-success" asp-action="AllDiscounts" asp-controller="Discount">
                        😅 View Discount
                    </a>
                }
                @if (User.IsInRole("User"))
                {
                    <a class="py-2 d-none d-md-inline-block btn btn-outline-success" asp-action="ViewCart" asp-controller="Cart">
                        🛒 View Cart
                    </a>
                    <a class="py-2 d-none d-md-inline-block btn btn-outline-danger" asp-action="DiscountedProducts" asp-controller="Discount">
                        🔥 Discounted Products
                    </a>
                    <a class="py-2 d-none d-md-inline-block btn btn-outline-danger" asp-action="MyOrders" asp-controller="Orders">
                        🤑 My Orders
                    </a>
                }

                <a class="py-2 d-none d-md-inline-block" href="#">Hello, @Context.User.Identity.Name!</a>
                <a class="py-2 d-none d-md-inline-block" asp-action="Signout" asp-controller="Account">SignOut</a>
            }

        </div>
    </nav>

    <div class="container-fluid">
        @RenderBody() <!-- هذا هو الجزء المهم -->
    </div>
   
    <footer>
    </footer>


    <!-- Bootstrap core JavaScript
    ================================================== -->
    <!-- Placed at the end of the document so the pages load faster -->
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
    <script>window.jQuery || document.write('<script src="../../assets/js/vendor/jquery-slim.min.js"><\/script>')</script>
    <script src="../../assets/js/vendor/popper.min.js"></script>
    <script src="../../dist/js/bootstrap.min.js"></script>
    <script src="../../assets/js/vendor/holder.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        Holder.addTheme('thumb', {
          bg: '#55595c',
          fg: '#eceeef',
          text: 'Thumbnail'
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>


