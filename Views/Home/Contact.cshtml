@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

}

<div class="container my-5">
    <h1 class="font-weight-bold text-primary text-center mb-5">Get in Touch with Us</h1>

    <div class="row">
        <!-- Contact Info -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h3 class="card-title mb-4">Contact Information</h3>
                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <i class="fas fa-envelope text-primary mr-2"></i>
                            <span>Email: <a href="mailto:support@supermarketms.com">marwanhosni785@gmail.com</a></span>
                        </li>
                        <li class="mb-3">
                            <i class="fas fa-phone-alt text-primary mr-2"></i>
                            <span>Phone: +20 121 288 2622</span>
                        </li>
                        <li class="mb-3">
                            <i class="fas fa-map-marker-alt text-primary mr-2"></i>
                            <span>Address: Supermarket Street, Zagazig , Sharkia , Cairo , Egypt</span>
                        </li>
                    </ul>
                    <div class="mt-4">
                        <h5 class="mb-3">Follow Us</h5>
                        <div class="d-flex  mt-3">
                            <a href="https://www.instagram.com/marwan_hosni_/" class="text-danger mx-3" target="_blank">
                                <i class="fab fa-instagram fa-2x"></i>
                                <span class="ml-2">Instagram</span>
                            </a>
                            <a href="https://www.facebook.com/marwan.elgoker.14" class="text-primary mx-3" target="_blank">
                                <i class="fab fa-facebook fa-2x"></i>
                                <span class="ml-2">Facebook</span>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Google Map -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-0">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d164.33355138933584!2d31.517620322889158!3d30.599110189079724!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e1!3m2!1sar!2seg!4v1746145153727!5m2!1sar!2seg"
                            width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>

                    <!-- زر فتح الموقع على جوجل ماب -->
                    <div class="text-center mt-3">
                        <a href="https://maps.app.goo.gl/MUXENJ4WR2ZNA7Dp6" target="_blank" class="btn btn-primary">
                            📍 Open Location in Google Maps
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
    }

    iframe {
        border-radius: 15px;
    }

    .list-unstyled li {
        font-size: 1.1rem;
    }

    .list-unstyled i {
        width: 30px;
    }
</style>