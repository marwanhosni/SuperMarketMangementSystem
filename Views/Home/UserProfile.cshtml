@model ApplicationUser
@{
    var roles = ViewData["Roles"] as IList<string>;
    Layout = "~/Views/Shared/_CategoryLayout.cshtml";
}

<h2 class="text-center my-4">User Profile</h2>

<div class="container">
    <div class="row">
        <div class="col-12 col-md-6">
            <div class="mb-3">
                <label class="form-label"><strong>Username:</strong></label>
                <div class="form-control-plaintext">@Model.UserName</div>
            </div>
            <div class="mb-3">
                <label class="form-label"><strong>Email:</strong></label>
                <div class="form-control-plaintext">@Model.Email</div>
            </div>
            <div class="mb-3">
                <label class="form-label"><strong>Phone Number:</strong></label>
                <div class="form-control-plaintext">@Model.PhoneNumber</div>
            </div>
            <div class="mb-3">
                <label class="form-label"><strong>Address:</strong></label>
                <div class="form-control-plaintext">@Model.Address</div>
            </div>
        </div>  

        <div class="col-12 col-md-6">
            <div class="mb-3">
                <label class="form-label"><strong>Another Phone Number:</strong></label>
                <div class="form-control-plaintext">@Model.AnotherPhoneNumber</div>
            </div>
            <div class="mb-3">
                <label class="form-label"><strong>Role:</strong></label>
                <div class="form-control-plaintext">@string.Join(", ", roles)</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center mt-4 mb-4">
    <form asp-controller="Account" asp-action="ShowUserToken" method="get">
        <button type="submit" class="btn btn-primary" style="min-width: 200px;">Show Your Token</button>
    </form>
</div>


<style>
    .form-control-plaintext {
        background-color: #f8f9fa;
        padding: .375rem .75rem;
        border: 1px solid #dcdcdc;
        border-radius: .375rem;
    }
</style>
